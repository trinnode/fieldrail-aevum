{
  "name": "fieldrail",
  "private": true,
  "version": "0.1.0",
  "description": "Purpose-bound stablecoin disbursement and agentic procurement on QDay Aevum",
  "scripts": {
    "check": "pnpm -r typecheck && pnpm -r lint && pnpm -r build",
    "test": "pnpm -r test",
